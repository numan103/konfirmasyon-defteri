        "delta-agg": {
          "script": "_vbuy = (\n  COINBASE:BTC-USD.vbuy + COINBASE:BTC-USDT.vbuy + COINBASE:BTC-USDC.vbuy +\n  BINANCE:btcusdt.vbuy + BINANCE:btcusdc.vbuy +\n  BYBIT:BTCUSDT-SPOT.vbuy +\n  OKEX:BTC-USDT.vbuy +\n  BITFINEX:BTCUSD.vbuy + BITFINEX:BTCUST.vbuy +\n  KRAKEN:XBT/USD.vbuy + KRAKEN:XBT/USDT.vbuy +\n  KUCOIN:BTC-USDT.vbuy +\n  BITSTAMP:btcusd.vbuy + BITSTAMP:btcusdt.vbuy +\n  BITGET:BTCUSDT.vbuy +\n  MEXC:BTCUSDT.vbuy\n)\n\n_vsell = (\n  COINBASE:BTC-USD.vsell + COINBASE:BTC-USDT.vsell + COINBASE:BTC-USDC.vsell +\n  BINANCE:btcusdt.vsell + BINANCE:btcusdc.vsell +\n  BYBIT:BTCUSDT-SPOT.vsell +\n  OKEX:BTC-USDT.vsell +\n  BITFINEX:BTCUSD.vsell + BITFINEX:BTCUST.vsell +\n  KRAKEN:XBT/USD.vsell + KRAKEN:XBT/USDT.vsell +\n  KUCOIN:BTC-USDT.vsell +\n  BITSTAMP:btcusd.vsell + BITSTAMP:btcusdt.vsell +\n  BITGET:BTCUSDT.vsell +\n  MEXC:BTCUSDT.vsell\n)\n\nplothistogram({ time: time, value: (_vbuy-_vsell), color: _vbuy - _vsell > 0 ? options.upColor : options.downColor}, title=Aggregate Spot Delta)",

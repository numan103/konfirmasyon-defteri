{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/alfa-qa-invariants.md",
    "docs/alfa-qa-agent-playbook.md"
  ],
  "worktree": {
    "directory": "../alfa-qa-worktrees"
  },
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "wrangler pages deploy *", "effect": "deny" },
    { "action": "shell", "resource": "wrangler pages deployment create *", "effect": "deny" },
    { "action": "shell", "resource": "git merge *", "effect": "ask" }
  ]
}
